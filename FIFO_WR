module FIFO_WR
#(
    parameter FIFO_DEPTH = 8,
    parameter Data_Width = 8
)  


(
input logic  Wr_CLK, RST,
input logic Burst_Incoming,
input logic [$clog2(FIFO_DEPTH) :0] Rd_Pointer, 
output logic [$clog2(FIFO_DEPTH) :0] Wr_Pointer,
output logic Fifo_Full
);






logic [$clog2(FIFO_DEPTH) :0] pointer;

logic fifo_full;


always @(posedge Wr_CLK or negedge RST) begin
    if(!RST) begin
        pointer <= 0;
        fifo_full <= 0;
    end    

    else begin
        

        if (Burst_Incoming && !Fifo_Full) begin
            pointer <= pointer + 1;
            
        end

        fifo_full <= ( Wr_Pointer[$clog2(FIFO_DEPTH)] != Rd_Pointer[$clog2(FIFO_DEPTH)] ) &&  ( Wr_Pointer[$clog2(FIFO_DEPTH)-1:0] == Rd_Pointer [$clog2(FIFO_DEPTH)-1:0] );

    end


end



assign Wr_Pointer = pointer;
assign Fifo_Full = fifo_full;




endmodule