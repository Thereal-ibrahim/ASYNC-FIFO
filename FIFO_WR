module FIFO_WR
#(
    parameter FIFO_DEPTH = 8,
    parameter Data_Width = 8,
    parameter POINTER_WIDTH = $clog2(FIFO_DEPTH)
)  


(
input logic  Wr_CLK, RST,
input logic Wr_Req,
input logic [POINTER_WIDTH :0] Rd_Pointer, 
output logic [POINTER_WIDTH :0] Wr_Pointer,
output logic Fifo_Full
);






logic [POINTER_WIDTH :0] pointer;
logic [POINTER_WIDTH :0] gray_pointer;
logic fifo_full;


always @(posedge Wr_CLK or negedge RST) begin
    if(!RST) begin
        pointer <= 0;
        fifo_full <= 0;
    end    

    else begin
        

        if (Wr_Req && !Fifo_Full) begin
            pointer <= pointer + 1;
            
        end

        fifo_full <= ( Wr_Pointer[POINTER_WIDTH] != Rd_Pointer[POINTER_WIDTH] ) &&  ( Wr_Pointer[POINTER_WIDTH-1:0] == Rd_Pointer [POINTER_WIDTH-1:0] );

    end


end


assign gray_pointer = Wr_Pointer ^ (Wr_Pointer >> 1);
assign Wr_Pointer = pointer;
assign Fifo_Full = fifo_full;




endmodule