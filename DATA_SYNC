module DATA_SYNC
#(

parameter DATA_WIDTH = 8

)


(
input logic CLK1, CLK2, RST,
input logic [DATA_WIDTH-1 : 0] Data_In,
output logic [DATA_WIDTH-1 : 0] Data_Out
);



logic [DATA_WIDTH-1 : 0] out1;
logic [DATA_WIDTH-1 : 0] out2;
logic [DATA_WIDTH-1 : 0] out3;



always @(posedge CLK1 or negedge RST) begin
    if(!RST) begin
        out1 <= 0;
    end
    else begin
        out1 <= Data_In;
    end

end



always @(posedge CLK2 or negedge RST) begin
    if(!RST) begin
        out2 <= 0;
        out3 <= 0;
    end
    else begin
        out2 <= out1;
        out3 <= out2;
    end

end


assign Data_Out <= out3;


endmodule