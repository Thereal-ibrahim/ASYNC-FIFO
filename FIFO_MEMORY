module FIFO_MEMORY
#(
    parameter DATA_WIDTH = 8,
    parameter FIFO_DEPTH = 8
)

(
    
    input logic Wr_CLK, Rd_CLK, n_MEM_RST,

    input logic [DATA_WIDTH-1:0] Wr_Data, //data received from oustide module
    output logic [DATA_WIDTH-1:0] Rd_Data, //data sent to outside module

    input logic Wr_en, Rd_en,
    input logic [$clog2(FIFO_DEPTH)-1 : 0] Wr_Add,
    input logic [$clog2(FIFO_DEPTH)-1 : 0] Rd_Add







);


//memory slots
logic [DATA_WIDTH-1:0] register [0:FIFO_DEPTH-1];


//memory dumb
//memory see Wr_en .. memory write Wr_Data in register [Wr_Add]
//memory see Rd_en .. memory output register[Rd_add] through Rd_Data port




always @(posedge Wr_CLK or negedge n_MEM_RST) begin
    
    if (!n_MEM_RST) begin
        for (int i = 0; i<FIFO_DEPTH; i++) begin
            register [i] <= '0;

        end

    end

    else 

    if (Wr_en) begin
        register [Wr_Add] <= Wr_Data;
    end

end


always @(posedge Rd_CLK or negedge n_MEM_RST) begin
    
    if (!n_MEM_RST) begin
       Rd_Data <= '0;
    end

    else 

    if (Rd_en) begin
        Rd_Data <= register[Rd_Add];
    end

    else begin
        Rd_Data <= 0; 
    end
end







endmodule